# CotaSync TESTE isolado
BACKEND_PORT=8100
FRONTEND_PORT=3100
BROWSERLESS_PORT=3010
DESKTOP_BROWSER_VIEW_PORT=3200
DESKTOP_BROWSER_CDP_PORT=9222
COTASYNC_PUBLIC_BASE_URL=https://cotasync.example.com
COTASYNC_BROWSERLESS_PUBLIC_URL=https://browserless-cotasync.example.com
COTASYNC_DESKTOP_VIEW_PUBLIC_BASE_URL=https://desktop-cotasync.ferriolimidias.com.br
COTASYNC_DESKTOP_VIEW_TOKEN_TTL_SECONDS=1800

# Providers: browserless (padrao) ou desktop_browser.
COTASYNC_BROWSER_MODE=browserless
BROWSERLESS_URL=ws://cotasync_test_browserless:3000
DESKTOP_BROWSER_CDP_URL=http://cotasync_test_desktop_browser:9222
DESKTOP_BROWSER_VIEW_URL=http://127.0.0.1:3200/vnc.html?autoconnect=1&resize=scale
DESKTOP_BROWSER_PROFILE_DIR=/data/profile
DATABASE_URL=postgresql://cotasync_test:cotasync_test_password@cotasync_test_postgres:5432/cotasync_test
REDIS_URL=redis://cotasync_test_redis:6379/0

# Placeholders de teste. Nao usar credenciais reais neste ambiente.
OPENAI_API_KEY=placeholder_openai_api_key
OPENAI_MODEL=gpt-4o-mini
EVOLUTION_API_KEY=placeholder_evolution_api_key
EVOLUTION_BASE_URL=http://placeholder-evolution.local
EXTERNAL_LOGIN=placeholder_login
EXTERNAL_PASSWORD=placeholder_password
